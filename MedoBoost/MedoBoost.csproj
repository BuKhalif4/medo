<Project Sdk="Microsoft.NET.Sdk">
  <!-- KHA Boost - Windows optimizer, cleaner and performance monitor.
       Built as a code-first WPF app so it can be compiled from Windows, Linux or CI. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>MedoBoost</RootNamespace>
    <AssemblyName>KHABoost</AssemblyName>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>KHA Boost</Product>
    <Company>KHA</Company>
    <Description>KHA Boost - PC optimizer</Description>
    <Copyright>KHA</Copyright>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>CA1416;CS8632;SYSLIB0014</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.30" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\logo.png" LogicalName="logo.png" />
    <EmbeddedResource Include="Assets\logo.ico" LogicalName="logo.ico" />
    <EmbeddedResource Include="Theme.xaml" LogicalName="Theme.xaml" />
    <EmbeddedResource Include="ThemePrime.xaml" LogicalName="ThemePrime.xaml" />
  </ItemGroup>
</Project>
