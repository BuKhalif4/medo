<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============ KHA Prime: matte black, bone type, a single ember accent, hairlines ============ -->
  <SolidColorBrush x:Key="Bg" Color="#FF0C0C0D"/>
  <SolidColorBrush x:Key="Surface" Color="#FF121214"/>
  <SolidColorBrush x:Key="Surface2" Color="#FF171719"/>
  <SolidColorBrush x:Key="Surface3" Color="#FF202023"/>
  <SolidColorBrush x:Key="BorderB" Color="#FF2A2A2E"/>
  <SolidColorBrush x:Key="Text" Color="#FFECE8E1"/>
  <SolidColorBrush x:Key="TextDim" Color="#FFA29E96"/>
  <SolidColorBrush x:Key="TextMute" Color="#FF6B6862"/>
  <SolidColorBrush x:Key="Accent" Color="#FFFF5B2E"/>
  <SolidColorBrush x:Key="Accent2" Color="#FFD9D3C5"/>
  <SolidColorBrush x:Key="Pink" Color="#FFFF5B2E"/>
  <SolidColorBrush x:Key="Good" Color="#FF9DB596"/>
  <SolidColorBrush x:Key="Warn" Color="#FFE0B050"/>
  <SolidColorBrush x:Key="Bad" Color="#FFE5484D"/>
  <SolidColorBrush x:Key="Ink" Color="#FF0C0C0D"/>
  <!-- the old "gradient" keys are flat here on purpose -->
  <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FFFF5B2E" Offset="0"/><GradientStop Color="#FFFF5B2E" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AccentGradH" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#FFFF5B2E" Offset="0"/><GradientStop Color="#FFFF5B2E" Offset="1"/>
  </LinearGradientBrush>

  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="UiFont">Bahnschrift, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

  <!-- ===================== Buttons: ink wipe, physical press ===================== -->
  <Style x:Key="Btn" TargetType="Button">
    <Setter Property="Foreground" Value="#FF0C0C0D"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="18,10"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Background" Value="#FFFF5B2E"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><TranslateTransform Y="0"/></Grid.RenderTransform>
            <Border x:Name="bg" CornerRadius="2" Background="{TemplateBinding Background}"/>
            <Border x:Name="wipe" CornerRadius="2" Background="#FFECE8E1" RenderTransformOrigin="0,0.5">
              <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
            </Border>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="wipe" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="wipe" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0" Duration="0:0:0.18"/>
              </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="2" Duration="0:0:0.05"/>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction></DoubleAnimation>
              </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BtnGhost" TargetType="Button">
    <Setter Property="Foreground" Value="#FFECE8E1"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Padding" Value="18,9"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><TranslateTransform Y="0"/></Grid.RenderTransform>
            <Border x:Name="bd" CornerRadius="2" BorderThickness="1" BorderBrush="#FF3A3936" Background="{TemplateBinding Background}"/>
            <Border x:Name="line" Height="2" VerticalAlignment="Bottom" Margin="1,0,1,1" Background="#FFFF5B2E" RenderTransformOrigin="0,0.5">
              <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
            </Border>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="#FFA29E96"/>
              <Setter TargetName="bd" Property="Background" Value="#FF1A1A1C"/>
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="line" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.26"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="line" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0" Duration="0:0:0.16"/>
              </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="2" Duration="0:0:0.05"/>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction></DoubleAnimation>
              </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
    <Setter Property="Foreground" Value="#FFE5484D"/>
  </Style>

  <Style x:Key="IconBtn" TargetType="Button">
    <Setter Property="Foreground" Value="#FFA29E96"/>
    <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#22ECE8E1"/><Setter Property="Foreground" Value="#FFECE8E1"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#FFE5484D"/><Setter Property="Foreground" Value="White"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== Function keys (page navigation) ===================== -->
  <Style x:Key="FKey" TargetType="RadioButton">
    <Setter Property="Foreground" Value="#FFA29E96"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="3,0"/>
    <Setter Property="Height" Value="60"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="wall" CornerRadius="5" Background="#FF08080A" BorderBrush="#FF2A2A2E" BorderThickness="1"/>
            <Border x:Name="face" CornerRadius="5" Margin="0,0,0,6" Background="#FF1E1E21" BorderBrush="#FF38383D" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
              <Grid>
                <Border x:Name="lamp" Height="3" VerticalAlignment="Top" Margin="16,0,16,0" Background="#FFFF5B2E" Opacity="0.12" CornerRadius="0,0,2,2"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock x:Name="num" Text="{TemplateBinding Tag}" FontFamily="{StaticResource MonoFont}" FontSize="9.5" HorizontalAlignment="Center" Foreground="#FF6B6862"/>
                  <ContentPresenter x:Name="label" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="face" Property="Background" Value="#FF28282C"/>
              <Setter Property="Foreground" Value="#FFECE8E1"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="face" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="4" Duration="0:0:0.04"/>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="#FFECE8E1"/>
              <Setter TargetName="num" Property="Foreground" Value="#FFFF5B2E"/>
              <Setter TargetName="face" Property="BorderBrush" Value="#FF5A5852"/>
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="face" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="4" Duration="0:0:0.32"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.9"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="lamp" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="face" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="lamp" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.25"/>
              </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- keeps old key alive for any page that asks for it -->
  <Style x:Key="NavBtn" TargetType="RadioButton" BasedOn="{StaticResource FKey}"/>

  <!-- ===================== Segmented choice ===================== -->
  <Style x:Key="Pill" TargetType="RadioButton">
    <Setter Property="Foreground" Value="#FFA29E96"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="0,0,-1,6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Padding="14,7" Background="Transparent" BorderBrush="#FF3A3936" BorderThickness="1">
            <Grid>
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
              <Border x:Name="u" Height="2" VerticalAlignment="Bottom" Margin="-14,0,-14,-7" Background="#FFFF5B2E" Opacity="0"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#FF1A1A1C"/><Setter Property="Foreground" Value="#FFECE8E1"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="#FFECE8E1"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="#FFECE8E1"/>
              <Setter TargetName="bd" Property="Background" Value="#FF202023"/>
              <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="u" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="u" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== Toggle: a sliding block ===================== -->
  <Style x:Key="Switch" TargetType="ToggleButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid FlowDirection="LeftToRight">
            <Border x:Name="track" CornerRadius="2" Background="#FF121214" BorderBrush="#FF3A3936" BorderThickness="1"/>
            <Border x:Name="fill" CornerRadius="2" Background="#FFFF5B2E" Opacity="0" Margin="1"/>
            <Border x:Name="knob" Width="18" Height="16" CornerRadius="1" Background="#FFA29E96" HorizontalAlignment="Left" Margin="3,0,0,0" RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform><TranslateTransform X="0"/></Border.RenderTransform>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="track" Property="BorderBrush" Value="#FFA29E96"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="knob" Property="Background" Value="#FF0C0C0D"/>
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="22" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.7"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="fill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.24"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="fill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
              </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== Checkbox: the tick is drawn on ===================== -->
  <Style x:Key="Chk" TargetType="CheckBox">
    <Setter Property="Foreground" Value="#FFECE8E1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Width="20" Height="20" VerticalAlignment="Center">
              <Border x:Name="box" CornerRadius="2" BorderThickness="1" BorderBrush="#FF5A5852" Background="#FF121214"/>
              <Border x:Name="fill" CornerRadius="2" Background="#FFFF5B2E" Opacity="0"/>
              <Path x:Name="tick" Data="M5,10 L9,14 L15.5,6" Stroke="#FF0C0C0D" StrokeThickness="2" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" StrokeDashArray="9 9" StrokeDashOffset="9"/>
            </Grid>
            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#FFECE8E1"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="fill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/>
                <DoubleAnimation Storyboard.TargetName="tick" Storyboard.TargetProperty="StrokeDashOffset" From="9" To="0" Duration="0:0:0.22"/>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="fill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                <DoubleAnimation Storyboard.TargetName="tick" Storyboard.TargetProperty="StrokeDashOffset" To="9" Duration="0:0:0.01"/>
              </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== Text input ===================== -->
  <Style x:Key="Input" TargetType="TextBox">
    <Setter Property="Foreground" Value="#FFECE8E1"/>
    <Setter Property="CaretBrush" Value="#FFFF5B2E"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="SelectionBrush" Value="#FFFF5B2E"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" CornerRadius="2" Background="#FF121214" BorderBrush="#FF2A2A2E" BorderThickness="1">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#FFFF5B2E"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== Progress: a thin rule ===================== -->
  <Style x:Key="Prog" TargetType="ProgressBar">
    <Setter Property="Height" Value="4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border x:Name="PART_Track" Background="#FF232326"/>
            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="#FFFF5B2E"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== Scroll bar ===================== -->
  <Style x:Key="ThumbStyle" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="t" CornerRadius="1" Background="#FF3A3936"/>
          <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="#FFFF5B2E"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="7"/>
    <Setter Property="MinWidth" Value="7"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True"><Track.Thumb><Thumb Style="{StaticResource ThumbStyle}" Margin="2,2"/></Track.Thumb></Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="7"/><Setter Property="MinHeight" Value="7"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="False"><Track.Thumb><Thumb Style="{StaticResource ThumbStyle}" Margin="2,2"/></Track.Thumb></Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===================== Tooltip / menus ===================== -->
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="#FFECE8E1"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border CornerRadius="2" Background="#FF1E1E21" BorderBrush="#FF3A3936" BorderThickness="1" Padding="10,6" MaxWidth="380">
            <ContentPresenter><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></ContentPresenter.Resources></ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ContextMenu">
    <Setter Property="Foreground" Value="#FFECE8E1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border CornerRadius="2" Background="#FF171719" BorderBrush="#FF3A3936" BorderThickness="1" Padding="3"><StackPanel IsItemsHost="True"/></Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="#FFECE8E1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="bd" CornerRadius="1" Padding="12,7" Background="Transparent"><ContentPresenter ContentSource="Header"/></Border>
          <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="bd" Property="Background" Value="#FF2A2A2E"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
